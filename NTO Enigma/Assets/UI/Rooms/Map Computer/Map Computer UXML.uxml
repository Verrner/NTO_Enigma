<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Main%20Styles%20Overrides%20USS.uss?fileID=7433441132597879392&amp;guid=ca37d606641a9f848acecba0437296a1&amp;type=3#Main Styles Overrides USS" />
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgba(30, 30, 30, 0.89); flex-direction: row; justify-content: space-between;">
        <ui:VisualElement name="vertical-position-info-container" style="flex-grow: 1; width: 20%; min-width: 20%; max-width: 20%; flex-direction: column-reverse; justify-content: space-between;">
            <ui:Label text="Label" name="depth-level-label" style="color: rgb(161, 161, 161); width: 100%; min-width: 100%; max-width: 100%; -unity-text-align: middle-center; margin-top: 5px; margin-right: 0; margin-bottom: 5px; margin-left: 0;" />
            <ui:VisualElement name="vertical-position-slider-background" style="flex-grow: 1; align-self: center; width: 20px; min-width: 20px; max-width: 20px; background-color: rgb(207, 207, 207); overflow: hidden;">
                <ui:VisualElement name="vertical-position-slider" style="flex-grow: 1; width: 100%; min-width: 100%; max-width: 100%; height: 10px; min-height: 10px; max-height: 10px; background-color: rgb(207, 0, 0); top: 100%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="horizontal-position-info-container" style="flex-grow: 1; flex-direction: row-reverse;">
            <ui:VisualElement name="chunks-matrix" style="flex-grow: 0; align-self: center; flex-shrink: 1; flex-direction: row; flex-wrap: wrap;">
                <ui:VisualElement name="submarine-element" style="flex-grow: 1; height: 50px; width: 50px; min-width: 50px; min-height: 50px; max-width: 50px; max-height: 50px; background-image: url(&quot;project://database/Assets/UI/UI%20Resources/Submarine%20Element%20Icon.png?fileID=2800000&amp;guid=2fede558346f60446bef94802d2e9ee1&amp;type=3#Submarine Element Icon&quot;); background-size: 100% 300%; -unity-background-image-tint-color: rgb(207, 0, 0); position: absolute; top: 0; left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
