  - key: tutorial-tooltip
    choiceMethod: 0
    values:
    - condition: 
      value: "\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E"
  - key: tutorial-controls-tooltip
    choiceMethod: 0
    values:
    - condition: 
      value: "D - \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439/A - \u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439/Esc
        - \u0412\u044B\u0445\u043E\u0434"
  - key: tutorial-page-1
    choiceMethod: 0
    values:
    - condition: 
      value: "\u0412\u0430\u0436\u043D\u044B\u0435 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B:\n\u0412\u0441\u0435\u0433\u0434\u0430
        \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C,
        \u043D\u0435 \u0434\u0430\u0439\u0442\u0435 \u0435\u043C\u0443 \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F
        \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u044B\u0441\u043E\u043A\u043E,
        \u0432 \u0438\u043D\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435 \u0432\u0430\u0441
        \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442
        \u0441\u0438\u0440\u0435\u043D\u0430\n\u0412\u0441\u0435\u0433\u0434\u0430
        \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u043C
        \u044D\u043D\u0435\u0440\u0433\u0438\u0438: \u043D\u0435 \u043F\u043B\u044B\u0432\u0438\u0442\u0435
        \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u044B\u0441\u0442\u0440\u043E,
        \u043D\u0435 \u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435\u0441\u044C
        \u0444\u043E\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A,
        \u0432\u0430\u0441 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0430\u0441\u0435\u0442,
        \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F\n\u0412\u0441\u0435\u0433\u0434\u0430
        \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u043E\u043C
        \u0438 \u043C\u0435\u043D\u044F\u0439\u0442\u0435 \u0431\u0430\u043B\u043B\u043E\u043D,
        \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u043D\u0435 \u0445\u043E\u0442\u044F\u0442
        \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0431\u0435\u0437 \u043F\u043E\u0441\u044B\u043B\u043E\u043A\n\u0412\u0441\u0435\u0433\u0434\u0430
        \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0448\u0443\u043C\u043E\u043C
        \u0437\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u043C, \u043C\u0435\u0441\u0442\u043D\u0430\u044F
        \u0436\u0438\u0437\u043D\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u0430
        \n\u0418 \u043F\u043E\u043C\u043D\u0438\u0442\u0435: \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
        \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F \u043E \u0432\u0430\u0441!"
  - key: tutorial-page-2
    choiceMethod: 0
    values:
    - condition: 
      value: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043B\u043E\u0434\u043A\u043E\u0439:\n\u0423\u0433\u043E\u043B
        \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u043B\u043E\u0434\u043A\u0438
        \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0448\u0442\u0443\u0440\u0432\u0430\u043B\u0430.\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u043B\u043E\u0434\u043A\u0438 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
        \u0440\u044B\u0447\u0430\u0436\u043A\u0430.\n\u041F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435/\u0432\u0441\u043F\u043B\u044B\u0442\u0438\u0435
        \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u043E\u0434\u0432\u0435\u0441\u043D\u043E\u0433\u043E
        \u0440\u044B\u0447\u0430\u0433\u0430.\n\n\u041A\u0430\u0440\u0442\u0430:\n\u0421\u0435\u0440\u044B\u0439
        - \u043E\u0431\u044B\u0447\u043D\u044B\u0439.\n\u0413\u043E\u043B\u0443\u0431\u043E\u0439
        - \u0447\u0430\u043D\u043A \u0441 \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C.\n\u0416\u0435\u043B\u0442\u044B\u0439
        - ???\n\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439 - \u0447\u0430\u043D\u043A
        \u0441 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C.\n\u0424\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439
        - \u043F\u0443\u043D\u043A\u0442 \u0432\u044B\u0434\u0430\u0447\u0438 \u0437\u0430\u043A\u0430\u0437\u0430."
  - key: tutorial-page-3
    choiceMethod: 0
    values:
    - condition: 
      value: "\u0424\u043E\u0442\u043E \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F:\n\u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435
        \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u0434\u043B\u043E\u0434\u043A\u0438,
        \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u044F\u0432\u0438\u0442\u044C
        \u043F\u0440\u0438\u0447\u0438\u043D\u0443 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
        \u043E\u0431\u0448\u0438\u0432\u043A\u0438.\n\n\u0415\u0441\u043B\u0438 \u0432\u044B
        \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0441\u0432\u0435\u0442 - \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0439\u0442\u0435\u0441\u044C
        \u0431\u044B\u0441\u0442\u0440\u0435\u0435.\n\u0415\u0441\u043B\u0438 \u0432\u044B
        \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u043A\u043E\u0433\u043E-\u0442\u043E
        \u0441\u043D\u0438\u0437\u0443 - \u0443\u043F\u043B\u044B\u0432\u0430\u0439\u0442\u0435
        \u0431\u044B\u0441\u0442\u0440\u0435\u0435.\n\u0415\u0441\u043B\u0438 \u0432\u044B
        \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u043A\u043E\u0433\u043E-\u0442\u043E
        \u0435\u0449\u0451 - \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0435\u0441\u044C
        \u0438 \u043D\u0435 \u0438\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435
        \u043D\u0438 \u0437\u0432\u0443\u043A\u0430.\n\n\u041F\u043E\u0447\u0438\u043D\u043A\u0430
